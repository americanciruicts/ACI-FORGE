# Database Configuration
# Using ACI consolidated database structure
# ACI DATABASE has separate databases: aci_forge (ACI Dashboard), nexus (NEXUS), kosh (KOSH)
DATABASE_URL=postgresql://aci_dashboard_user:postgres@aci-database:5432/aci_forge

# JWT Configuration  
JWT_SECRET_KEY=aSK1LtZz7jqianX3Xz1AEcSjHQRbnY30tNlDptwu6T2DOxDuKyzcjOriZYWNNCoM
JWT_REFRESH_SECRET_KEY=SxYjdAjtiJo4jDC1CW8zZ/0NFV55Qeje4WevX5yDOcn9dwujUoQ6EMeWYvfLzNEb

# Token Expiration
# Access token expires after 10 hours (600 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=600
# Refresh token expires after 10 hours - forces re-login after 10 hours
# 10 hours = 0.4167 days
REFRESH_TOKEN_EXPIRE_DAYS=0.4167

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS Configuration - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://192.168.1.95:2005,http://localhost:2005,http://acidashboard.aci.local:2005,https://forge.americancircuits.net,https://aci-forge.vercel.app,https://aci-nexus.vercel.app,https://aci-kosh.vercel.app,https://bom-tool.vercel.app

# Email Configuration (SMTP disabled - using simulation mode)
SMTP_SERVER=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
FRONTEND_URL=https://forge.americancircuits.net

