{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://attend-highlighted-proportion-annotation.trycloudflare.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://attend-highlighted-proportion-annotation.trycloudflare.com/health"
    }
  ]
}
